# ─── Frontend (Vite) ─────────────────────────────────────────────
# Estas variables VITE_* se incrustan en el BUILD. Deben existir tanto
# localmente (.env) como en Vercel (Settings → Environment Variables)
# ANTES de compilar. Si faltan, la app no carga datos / queda en blanco.
# Valores en: Supabase → Project Settings → API
VITE_SUPABASE_URL="https://TU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="TU_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="TU_PROJECT_ID"

# ─── Analítica (opcional) ────────────────────────────────────────
# Si se definen, src/lib/analytics.ts inyecta GA4 y/o Meta Pixel en el
# build y empieza a medir (eventos: calcular_nahual, lead_enviado).
# Si se dejan vacías, la analítica es un no-op silencioso (sin errores).
VITE_GA_ID="G-XXXXXXXXXX"
VITE_META_PIXEL_ID="XXXXXXXXXXXXXXXXXX"

# ─── Monitoreo de errores (opcional, Sentry) ─────────────────────
# VITE_SENTRY_DSN activa el reporte de errores (src/lib/monitoring.ts).
# Las tres SENTRY_* (solo en build) suben sourcemaps para stacktraces
# legibles; sin ellas no se generan ni publican sourcemaps.
VITE_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── Email de la lectura (opcional, Resend — solo servidor) ──────
# Sin RESEND_API_KEY, /api/send-reading no envía y degrada con gracia.
# El dominio de EMAIL_FROM debe estar verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM="Tu Nahual <tu-nahual@tunahual.com>"

# ─── Serverless (api/sync-lead.ts) ───────────────────────────────
# Ninguna lleva prefijo VITE_ (son secretas, solo servidor). Configúralas
# solo en Vercel. Apuntan al proyecto Supabase del CRM "Azul Anaité OS"
# (hoy ref zuimegiggyumwbpimdhv — verificar en AZULANAITEOS/supabase/config.toml
# antes de asumirlo, el proyecto ya cambió de ref una vez).
AZULANAITEOS_URL="https://TU_PROJECT_REF.supabase.co"
AZULANAITEOS_SERVICE_KEY="TU_SERVICE_ROLE_KEY"
# UUID de la fila `trecenas` del CRM que corresponde a "Tu Nahual". Es del
# esquema del proyecto Supabase activo — si el CRM se reconstruye otra vez,
# este valor también hay que volver a verificarlo, no asumirlo.
AZULANAITEOS_TRECENA_ID="TU_TRECENA_UUID"
