# ─── Frontend (Vite) ─────────────────────────────────────────────
# Estas variables VITE_* se incrustan en el BUILD. Deben existir tanto
# localmente (.env) como en Vercel (Settings → Environment Variables)
# ANTES de compilar. Si faltan, la app no carga datos / queda en blanco.
# Valores en: Supabase → Project Settings → API
# (proyecto vigente: ref kthmoffuateddameqafx)
VITE_SUPABASE_URL="https://TU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="TU_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="TU_PROJECT_ID"

# ─── Analítica (opcional) ────────────────────────────────────────
# Si se definen, src/lib/analytics.ts inyecta GA4 y/o Meta Pixel en el
# build y empieza a medir (eventos: calcular_nahual, lead_enviado).
# Si se dejan vacías, la analítica es un no-op silencioso (sin errores).
VITE_GA_ID="G-XXXXXXXXXX"
VITE_META_PIXEL_ID="XXXXXXXXXXXXXXXXXX"

# ─── Monitoreo de errores (opcional, Sentry) ─────────────────────
# VITE_SENTRY_DSN activa el reporte de errores (src/lib/monitoring.ts).
# Las tres SENTRY_* (solo en build) suben sourcemaps para stacktraces
# legibles; sin ellas no se generan ni publican sourcemaps.
VITE_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── Email de la lectura (opcional, Resend — solo servidor) ──────
# Sin RESEND_API_KEY, /api/send-reading no envía y degrada con gracia.
# El dominio de EMAIL_FROM debe estar verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM="Tu Nahual <tu-nahual@tunahual.com>"

# ─── Serverless (api/sync-lead.ts) ───────────────────────────────
# Ninguna lleva prefijo VITE_ (son secretas, solo servidor). Configúralas
# solo en Vercel. Apuntan al proyecto Supabase del CRM "Azul Anaité OS"
# (hoy ref zuimegiggyumwbpimdhv — verificar en AZULANAITEOS/supabase/config.toml
# antes de asumirlo, el proyecto ya cambió de ref una vez).
AZULANAITEOS_URL="https://TU_PROJECT_REF.supabase.co"
AZULANAITEOS_SERVICE_KEY="TU_SERVICE_ROLE_KEY"
# UUID de la fila `trecenas` del CRM que corresponde a "Tu Nahual". Es del
# esquema del proyecto Supabase activo — si el CRM se reconstruye otra vez,
# este valor también hay que volver a verificarlo, no asumirlo.
AZULANAITEOS_TRECENA_ID="TU_TRECENA_UUID"

# ─── Oferta y contactos (opcional) ─────────────────────────────
# VITE_OFERTA_PDF_URL: liga de pago del "Mapa de Energía" (Kajabi/Stripe). Se hornea en el build.
# Sin ella, el cierre de la lectura invita a azulanaite.com.
VITE_OFERTA_PDF_URL=""
# KAJABI_WEBHOOK_URL: webhook que recibe el contacto con etiquetas "tunahual" y "nahual-<slug>"
# (formulario de Kajabi, Make o Zapier). Solo servidor. Sin ella api/kajabi.ts no envía nada.
KAJABI_WEBHOOK_URL=""

# ─── Cobro del Mapa de Energía · Stripe (cuenta de Azul Anaité) ───
# Sin llaves el sitio funciona igual: api/create-checkout responde 503 y
# api/stripe-webhook también. NUNCA pongas las llaves reales en este archivo.
# STRIPE_SECRET_KEY: llave restringida (restricted key) con permiso de escritura
# solo en Checkout Sessions. Solo servidor.
STRIPE_SECRET_KEY=""
# CHECKOUT_HABILITADO: INTERRUPTOR DE SERVIDOR del cobro. Sin "1", api/create-checkout responde 503 aunque
# existan las llaves de Stripe (tener la llave en Vercel no basta para vender). Encender solo al abrir ventas.
CHECKOUT_HABILITADO=""
# STRIPE_WEBHOOK_SECRET: «Signing secret» (whsec_…) del endpoint /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID: precio del producto «Tu Mapa de Energía» (11 USD, único).
# Opcional: sin él se cobra un price_data de 11 USD.
STRIPE_PRICE_ID=""
# SUPABASE_SERVICE_ROLE_KEY: para que el webhook escriba en public.pedidos
# (RLS sin políticas, solo esta llave). La URL sale de VITE_SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=""
# MAPA_PDF_BASE_URL: carpeta pública donde viven los 260 PDFs (mapa-<tono>-<nahual>.pdf,
# ej. mapa-7-aqabal.pdf). Sin ella la entrega queda «pendiente». Más RESEND_API_KEY y EMAIL_FROM (arriba).
MAPA_PDF_BASE_URL=""
# VITE_CHECKOUT_MAPA: "1" muestra el botón «Obtener mi Mapa · 11 USD» (se hornea en el build).
VITE_CHECKOUT_MAPA=""

# ─── Oráculo Maya (PDF a pedido) · INACTIVO ────────────────────
# Ver docs/oraculo-asincrono.md. Nada de esto se necesita mientras no se active.
# ORACULO_PDF_HABILITADO: "1" activa el aviso del webhook y la función api/generar-oraculo.
ORACULO_PDF_HABILITADO=""
# ORACULO_TOKEN: secreto largo con el que el webhook y los reprocesos llaman a generar-oraculo.
ORACULO_TOKEN=""
# CRON_SECRET: autoriza el cron diario que recoge pedidos pendientes.
CRON_SECRET=""
# ORACULO_TZ: zona horaria de la «fecha de compra» (por defecto America/Mexico_City).
ORACULO_TZ=""
# ORACULO_PERMITIR_BORRADOR: "1" salta la exigencia de revision: aprobada (SOLO pruebas en Preview; se ignora en producción).
ORACULO_PERMITIR_BORRADOR=""
# ORACULO_SIN_CORREO: "1" omite el envío de correo (SOLO Preview, para medir sin dominio verificado). Se ignora en producción.
ORACULO_SIN_CORREO=""
